.container {
  min-height: 100vh;
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 80rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(79, 70, 229, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(79, 70, 229, 0.3);
}

.tips {
  position: absolute;
  bottom: 60rpx;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
}

/* 邀请码弹窗 */
.invite-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.invite-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.invite-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
  margin-bottom: 16rpx;
}

.invite-desc {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.invite-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #f9fafb;
  margin-bottom: 16rpx;
}

.invite-error {
  font-size: 24rpx;
  color: #ef4444;
  text-align: center;
  margin-bottom: 16rpx;
  min-height: 36rpx;
}

.invite-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.invite-cancel {
  flex: 1;
  height: 80rpx;
  background: #f3f4f6;
  color: #374151;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.invite-confirm {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
