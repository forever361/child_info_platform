<view class="container">
  <view class="form">
    <view class="form-item">
      <text class="label">记录类型</text>
      <radio-group bindchange="onTypeChange">
        <label class="radio"><radio value="individual" checked="{{recordType === 'individual'}}" />个体</label>
        <label class="radio"><radio value="event" checked="{{recordType === 'event'}}" />事件/小组</label>
      </radio-group>
    </view>

    <view class="form-item">
      <text class="label">班级 <text class="required">*</text></text>
      <picker bindchange="onClassChange" value="{{classIndex}}" range="{{classList}}">
        <view class="picker">
          {{classList[classIndex] || '请选择班级'}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">观察对象 <text class="required">*</text></text>
      <input class="input" placeholder="请输入幼儿姓名或事件名称" value="{{targetName}}" data-field="targetName" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="label">观察时间</text>
      <picker mode="multiSelector" bindchange="onDateChange" value="{{dateIndex}}" range="{{dateList}}">
        <view class="picker">
          {{observationDateStr || '请选择观察时间'}}
        </view>
      </picker>
    </view>

    <!-- 学习与发展领域 -->
    <view class="form-item">
      <text class="label">领域 <text class="required">*</text></text>
      <picker bindchange="onDomainChange" value="{{domainIndex}}" range="{{domainList}}">
        <view class="picker">
          {{domainList[domainIndex] || '请选择领域'}}
        </view>
      </picker>
    </view>

    <!-- 行为分析维度（根据所选领域动态显示） -->
    <view class="analysis-section" wx:if="{{domainIndex > 0}}">
      <view class="section-title">{{domainLabels[domainIndex]}}</view>

      <!-- 维度评级列表 -->
      <view class="dimension-list">
        <view class="dimension-item" wx:for="{{currentDimensions}}" wx:key="name">
          <view class="dimension-name">{{item.name}}</view>
          <view class="dimension-desc">{{item.desc}}</view>
          <picker bindchange="onDimensionChange" data-index="{{index}}" value="{{item.levelIndex}}" range="{{levelList}}">
            <view class="level-picker">
              {{levelList[item.levelIndex] || '请选择等级'}}
            </view>
          </picker>
        </view>
      </view>

      <!-- 综合分析 -->
      <view class="analysis-textarea-wrap">
        <text class="analysis-label">综合分析</text>
        <textarea class="textarea analysis-textarea" placeholder="可手动输入分析内容，或从豆包复制分析结果粘贴于此" value="{{analysis}}" data-field="analysis" bindinput="onInput" />
      </view>
    </view>

    <view class="form-item" wx:if="{{domainIndex === 0}}">
      <text class="label">行为分析</text>
      <textarea class="textarea" placeholder="可手动输入分析内容，或从豆包复制分析结果粘贴于此" value="{{analysis}}" data-field="analysis" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="label">图片（最多9张）</text>
      <view class="images">
        <block wx:for="{{images}}" wx:key="index">
          <view class="image-item">
            <image src="{{item}}" mode="aspectFill" />
            <view class="remove" catchtap="removeImage" data-index="{{index}}">×</view>
          </view>
        </block>
        <view class="add-image" bindtap="chooseImage" wx:if="{{images.length < 9}}">
          <text>+</text>
        </view>
      </view>
    </view>
  </view>

  <view class="submit-bar">
    <button type="primary" bindtap="handleSubmit" loading="{{loading}}">{{isEdit ? '更新记录' : '保存记录'}}</button>
  </view>
</view>
