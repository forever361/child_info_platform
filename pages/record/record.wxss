.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 140rpx;
}

.form {
  background: #fff;
}

.form-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.required {
  color: #ef4444;
}

.radio {
  margin-right: 32rpx;
  font-size: 28rpx;
}

.input {
  font-size: 28rpx;
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #f3f4f6;
}

.input:focus {
  border-color: #4f46e5;
}

.picker {
  font-size: 28rpx;
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #f3f4f6;
}

.textarea {
  font-size: 28rpx;
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
  border: 2rpx solid #f3f4f6;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-item .remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ef4444;
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  background: #f9fafb;
  border: 2rpx dashed #d1d5db;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image text {
  font-size: 56rpx;
  color: #9ca3af;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-bar button {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.analysis-section {
  padding: 0 32rpx 32rpx;
  background: #fff;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #7c3aed;
  padding: 32rpx 0 24rpx;
  border-bottom: 2rpx solid #f3f4f6;
  margin-bottom: 24rpx;
}

.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dimension-item {
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
}

.dimension-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.dimension-desc {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
}

.level-picker {
  font-size: 28rpx;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  border: 2rpx solid #e5e7eb;
  color: #374151;
}

.analysis-textarea-wrap {
  margin-top: 32rpx;
}

.analysis-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.analysis-textarea {
  width: 100%;
  height: 200rpx;
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #f3f4f6;
  box-sizing: border-box;
  font-size: 28rpx;
}
