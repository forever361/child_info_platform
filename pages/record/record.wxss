.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 140rpx;
}

.form {
  background: #fff;
}

.form-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.required {
  color: #ef4444;
}

.radio {
  margin-right: 32rpx;
  font-size: 28rpx;
}

.input {
  font-size: 28rpx;
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #f3f4f6;
}

.input:focus {
  border-color: #4f46e5;
}

.picker {
  font-size: 28rpx;
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #f3f4f6;
}

.textarea {
  font-size: 28rpx;
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
  border: 2rpx solid #f3f4f6;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-item .remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ef4444;
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  background: #f9fafb;
  border: 2rpx dashed #d1d5db;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image text {
  font-size: 56rpx;
  color: #9ca3af;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-bar button {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}
