/* ===== Report Page Styles ===== */
.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
  background: #f5f7fa;
}

/* Header card */
.header-card {
  background: linear-gradient(135deg, #4A90D9 0%, #6AAAE8 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.child-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.child-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.class-name {
  font-size: 24rpx;
  background: rgba(255,255,255,0.25);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.meta-row {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-label {
  font-size: 20rpx;
  opacity: 0.8;
}

.meta-value {
  font-size: 24rpx;
  font-weight: 500;
}

.meta-value.accent {
  color: #ffd700;
}

/* Style toggle */
.style-toggle {
  display: flex;
  background: #fff;
  border-radius: 50rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.toggle-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 46rpx;
  font-size: 26rpx;
  color: #6b7280;
  transition: all 0.2s;
}

.toggle-btn.active {
  background: #4A90D9;
  color: #fff;
  font-weight: 600;
}

/* Card base */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-title.cartoon {
  font-size: 30rpx;
  color: #374151;
}

/* Radar chart */
.radar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.radar-canvas {
  width: 320px !important;
  height: 320px !important;
}

/* Trend chart */
.trend-card {
  overflow: hidden;
}

.trend-canvas {
  width: 340px !important;
  height: 220px !important;
}

/* Domain cards */
.domain-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.domain-card {
  border-left: 6rpx solid #4A90D9;
}

.domain-card.cartoon {
  border-left: none;
  border-radius: 24rpx;
  background: #fff;
}

.domain-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.domain-icon {
  font-size: 36rpx;
}

.domain-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
}

.domain-name.cartoon {
  font-size: 28rpx;
  color: #374151;
}

.level-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
}

.level-badge.simple {
  border-radius: 8rpx;
}

.level-excellent { background: linear-gradient(135deg, #10b981, #059669); }
.level-good { background: linear-gradient(135deg, #3b82f6, #2563eb); }
.level-normal { background: linear-gradient(135deg, #f59e0b, #d97706); }
.level-attention { background: linear-gradient(135deg, #ef4444, #dc2626); }

.dimensions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.dim-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f9fafb;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.dim-name {
  color: #6b7280;
}

.dim-level {
  font-weight: 600;
}

.dim-level.simple {
  font-size: 20rpx;
}

.level-excellent { color: #10b981; }
.level-good { color: #3b82f6; }
.level-normal { color: #f59e0b; }
.level-attention { color: #ef4444; }

.ai-comment {
  background: #f0f9ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #4A90D9;
}

.domain-card.cartoon .ai-comment {
  background: #fff;
  border: 2rpx solid #e0f2fe;
  border-left: 4rpx solid #38bdf8;
}

.ai-comment-text {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.6;
}

.family-tip {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tip-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #7c3aed;
}

.domain-card.cartoon .tip-label {
  color: #8b5cf6;
}

.tip-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* Overall comment */
.overall-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.8;
}

.progress-text {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
}

/* Home tips */
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #fefce8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.cartoon .tip-item {
  background: #fffbeb;
  border: 2rpx solid #fef3c7;
}

.tip-num {
  width: 36rpx;
  height: 36rpx;
  background: #f59e0b;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.tip-content {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
}

/* Bottom actions */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)) 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.btn-share {
  flex: 1;
  background: #fff;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  font-size: 28rpx;
  border-radius: 50rpx;
  line-height: 2.6;
}

.btn-save {
  flex: 1;
  background: #4A90D9;
  color: #fff;
  font-size: 28rpx;
  border-radius: 50rpx;
  line-height: 2.6;
}

.btn-save::after {
  border: none;
}

.btn-share::after {
  border: none;
}

/* Loading */
.loading-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-icon.cartoon {
  width: 100rpx;
  height: 100rpx;
  border: 8rpx solid #e0f2fe;
  border-top-color: #38bdf8;
  border-right-color: #a78bfa;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #6b7280;
}

.loading-sub {
  font-size: 22rpx;
  color: #9ca3af;
}

/* Error */
.error-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.error-icon {
  font-size: 80rpx;
}

.error-text {
  font-size: 28rpx;
  color: #ef4444;
  text-align: center;
}

.btn-retry {
  background: #4A90D9;
  color: #fff;
  font-size: 28rpx;
  border-radius: 50rpx;
  padding: 0 60rpx;
  line-height: 2.6;
}

.btn-retry::after {
  border: none;
}
