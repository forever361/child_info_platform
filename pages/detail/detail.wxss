.container {
  padding: 24rpx;
  padding-bottom: 220rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.target {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
}

.type {
  font-size: 22rpx;
  color: #4f46e5;
  background: #eef2ff;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.domain-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.dimension-display {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.dimension-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border-radius: 10rpx;
}

.dim-name {
  font-size: 28rpx;
  color: #374151;
}

.dim-level {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.level-0 {
  color: #059669;
  background: #d1fae5;
}

.level-1 {
  color: #2563eb;
  background: #dbeafe;
}

.level-2 {
  color: #d97706;
  background: #fef3c7;
}

.level-3 {
  color: #dc2626;
  background: #fee2e2;
}

.meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #9ca3af;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1f2937;
}

.content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #4b5563;
  white-space: pre-wrap;
}

.analysis {
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #4f46e5;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.images image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.linked-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.linked-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 10rpx;
  width: 100%;
  box-sizing: border-box;
}

.linked-item.current {
  background: #eef2ff;
  border: 2rpx solid #4f46e5;
}

.linked-item .time {
  font-size: 26rpx;
  color: #6b7280;
}

.linked-item .arrow {
  color: #9ca3af;
}

.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.actions button {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.actions button:first-child {
  background: #f3f4f6;
  color: #374151;
  border: none;
}

.actions button:nth-child(2) {
  background: #eef2ff;
  color: #4f46e5;
  border: none;
}

.actions button:last-child {
  background: #fef2f2;
  color: #ef4444;
  border: none;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
  color: #9ca3af;
}

/* 建构游戏观察详情样式 */
.info-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  color: #666;
  font-size: 26rpx;
}

.info-value {
  flex: 1;
  color: #333;
  font-size: 26rpx;
}

.obs-section {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.obs-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.obs-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.obs-checked {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.obs-checked text {
  font-size: 24rpx;
  color: #059669;
  line-height: 1.6;
}

.strategy-label, .desc-label {
  color: #666;
  margin-top: 8rpx;
}

.obs-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

.photo-section {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.slot-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #4A90D9;
  margin-bottom: 12rpx;
}

.slot-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.obs-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
}

.slot-desc {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
  margin-top: 8rpx;
}

.slot-desc .desc-label {
  color: #999;
}
