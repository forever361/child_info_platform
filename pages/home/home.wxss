.container {
  min-height: 100vh;
  background: #f7f8fa;
}

.header {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  padding: 40rpx;
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
}

.avatar-text {
  font-size: 40rpx;
  color: #fff;
  font-weight: 600;
}

.user-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-info .name {
  font-size: 36rpx;
  font-weight: 600;
}

.user-info .role {
  font-size: 24rpx;
  opacity: 0.8;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  width: fit-content;
}

.logout {
  font-size: 26rpx;
  opacity: 0.8;
}

.filter-bar {
  display: flex;
  padding: 24rpx;
  background: #fff;
  gap: 16rpx;
}

.search-input {
  flex: 1;
}

.search-input input {
  background: #f3f4f6;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.type-picker {
  background: #f3f4f6;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.list {
  padding: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #9ca3af;
}

.empty text:first-child {
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.empty .tip {
  font-size: 26rpx;
}

.item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.item-main {
  padding: 28rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.target-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.record-type {
  font-size: 22rpx;
  color: #4f46e5;
  background: #eef2ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.item-content {
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 28rpx;
  background: #fafafa;
  border-top: 1rpx solid #f3f4f6;
}

.delete-btn {
  font-size: 24rpx;
  color: #ef4444;
  padding: 8rpx 24rpx;
}

.loading, .no-more {
  text-align: center;
  padding: 24rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.4);
}

.add-btn text {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
}
