.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  background: #f5f5f5;
}

.header-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.header-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.header-row:last-child {
  border-bottom: none;
}

.label {
  width: 140rpx;
  color: #666;
  font-size: 28rpx;
}

.value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
}

.picker-value {
  flex: 1;
  color: #4A90D9;
  font-size: 28rpx;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #4A90D9;
}

.obs-item {
  margin-bottom: 24rpx;
}

.obs-item-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.obs-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.checkbox-item {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.checkbox-item checkbox {
  margin-right: 12rpx;
}

.checkbox-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  flex: 1;
}

.photo-slots {
  margin-top: 30rpx;
}

.slot-header {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.photo-slot {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.slot-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A90D9;
  margin-bottom: 16rpx;
}

.photo-area {
  margin-bottom: 16rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.add-photo-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  color: #999;
  font-size: 24rpx;
}

.slot-inputs {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-group {
  margin-top: 16rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.textarea-field {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  background: #fff;
}

.textarea-field.tall {
  min-height: 200rpx;
}

.voice-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
  color: #4A90D9;
  font-size: 26rpx;
  width: fit-content;
  margin-top: 12rpx;
}

.strategy-options {
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

.strategy-options .checkbox-item {
  width: 50%;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.radio-item radio {
  margin-right: 12rpx;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1);
}

.submit-btn {
  flex: 2;
  background: #4A90D9;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.export-btn {
  flex: 1;
  background: #52c41a;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.plan-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.plan-item {
  background: #f9f9f9;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
}

.plan-label {
  display: flex;
  margin-bottom: 10rpx;
}

.plan-num {
  color: #666;
  font-size: 26rpx;
  margin-right: 8rpx;
}

.plan-text {
  color: #333;
  font-size: 26rpx;
  line-height: 1.5;
  flex: 1;
}

.plan-input {
  width: 100%;
  padding: 12rpx 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #fff;
  box-sizing: border-box;
}
