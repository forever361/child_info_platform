.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #1f2937;
}

.ops text {
  font-size: 26rpx;
  color: #4f46e5;
  margin-left: 24rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #4b5563;
}

.radio-item radio {
  transform: scale(0.8);
  margin-right: 16rpx;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.form-item text {
  font-size: 28rpx;
  color: #4b5563;
}

.form-item input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  margin-left: 20rpx;
  color: #1f2937;
}

.record-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.record-item.selected {
  background: #eef2ff;
}

.record-item .info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.record-item .name {
  font-size: 28rpx;
  color: #1f2937;
}

.record-item .time {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.submit-bar button {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}
